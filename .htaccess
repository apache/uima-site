RewriteEngine On

# Generated from _data/docs.yml: the manuals used to live in /d/<project>-current/.
# Only the books are redirected; Javadoc and PDFs are still served from /d/.
RewriteRule ^d/uimaj-current/oas\.html$ /docs/uimaj/3.7.0/oas.html [R=301,L]
RewriteRule ^d/uimaj-current/tug\.html$ /docs/uimaj/3.7.0/tug.html [R=301,L]
RewriteRule ^d/uimaj-current/user\.html$ /docs/uimaj/3.7.0/user.html [R=301,L]
RewriteRule ^d/uimaj-current/fit\.html$ /docs/uimaj/3.7.0/fit.html [R=301,L]
RewriteRule ^d/uimaj-current/ref\.html$ /docs/uimaj/3.7.0/ref.html [R=301,L]
RewriteRule ^d/uimaj-current/tools\.html$ /docs/uimaj/3.7.0/tools.html [R=301,L]
RewriteRule ^d/uimaj-current/maint\.html$ /docs/uimaj/3.7.0/maint.html [R=301,L]
RewriteRule ^d/ruta-current/ruta\.html$ /docs/ruta/3.5.1/ruta.html [R=301,L]

